# ==========================================
# CivicPulse Environment Configuration
# ==========================================

# GCP Infrastructure
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCS_RAW_BUCKET=civicpulse-raw-data-lake
BIGQUERY_LOCATION=US

# BigQuery Dataset Names (Medallion Architecture)
BQ_BRONZE_DATASET=civicpulse_bronze
BQ_SILVER_DATASET=civicpulse_silver
BQ_GOLD_DATASET=civicpulse_gold

# Storage Mode: 'local' (development/testing) or 'gcs' (production cloud)
STORAGE_BACKEND=local
LOCAL_DATA_DIR=./data

# Transformation Engine: 'duckdb' (high-performance local) or 'pyspark' (distributed cluster)
PROCESSING_ENGINE=duckdb

# Chicago 311 Socrata Open Data API (SODA)
CHICAGO_311_ENDPOINT=https://data.cityofchicago.org/resource/v6vf-nfxy.json
# Optional: Register at data.cityofchicago.org for an App Token to raise rate limits from 1,000/hr to 50,000/hr
SOCRATA_APP_TOKEN=
SOCRATA_APP_SECRET=

# Ingestion Batch Settings
INGESTION_BATCH_SIZE=2000
INGESTION_MAX_RETRIES=5
INGESTION_BACKOFF_FACTOR=2.0
INGESTION_RATE_LIMIT_DELAY=0.2

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
